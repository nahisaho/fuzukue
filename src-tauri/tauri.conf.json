{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fuzukue",
  "version": "0.1.0",
  "identifier": "io.github.nahisaho.fuzukue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Fuzukue",
      "width": 1280,
      "height": 900,
      "minWidth": 760,
      "minHeight": 560,
      "backgroundColor": "#f5f4f0"
    }],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "targets": ["nsis"],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "shortDescription": "Markdown, beautifully read.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["Japanese", "English"], "displayLanguageSelector": true }
    }
  }
}
